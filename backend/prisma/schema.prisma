generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum Role {
  OWNER
  MEMBER
}

enum Category {
  EATING
  CHILLING
  EVENT_JOY
}

// ============ MODELS ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  city         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships    Membership[]
  suggestedPlaces SuggestedPlace[]

  @@map("users")
}

model Tenant {
  id        String   @id @default(cuid())
  groupName String   @unique @map("group_name")
  joinCode  String   @unique @map("join_code") @db.VarChar(12)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  places      SuggestedPlace[]

  @@map("tenants")
}

model Membership {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  role      Role     @default(MEMBER)
  isCurrent Boolean  @default(false) @map("is_current")
  joinedAt  DateTime @default(now()) @map("joined_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("memberships")
}

model SuggestedPlace {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  suggestedByUserId String   @map("suggested_by_user_id")
  name              String
  category          Category
  description       String?
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  suggestedBy User   @relation(fields: [suggestedByUserId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("suggested_places")
}

